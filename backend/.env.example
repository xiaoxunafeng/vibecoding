# ============ 大模型配置（OpenAI 兼容协议） ============
# 复制本文件为 .env 并填入你自己的 API Key

# ---- DeepSeek（经实测使用）----
LLM_BASE_URL=https://api.suyu.io/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# DeepSeek 官方直连（如走官方 API 则改为下面两行）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# 思考模式默认开关与思考强度（low/high/max）
THINKING_ENABLED_DEFAULT=true
REASONING_EFFORT=high

# ============ 应用配置 ============
SYSTEM_PROMPT=你是一个乐于助人的 AI 助手，请用简洁准确的中文回答问题。
HISTORY_LIMIT=20
MAX_TOKENS=2048
TEMPERATURE=0.7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
